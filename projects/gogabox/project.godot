; Engine configuration file.
; It's best edited using the editor UI, not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="GOGABox"
config/description="GOdot GAme Box - a whole arcade in your pocket. Endless mini-games, GOGACoin economy, unlockable games and skins. Ported from Python_Game_Box_PGB. Open source under MIT, zero ads."
run/main_scene="res://main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.227451, 0.137255, 0.074510, 1)
boot_splash/image="res://assets/ui/logo.png"
boot_splash/fullsize=false
config/icon="res://icon.svg"
# THE 60 LAW: the siege runs at a real 60 in both hardware and software
# v0.3.8-5 THE COMFORT LAW: the ENGINE cap stays 60; the box menu breathes
# at 30 (main.gd sets Engine.max_fps=30 at boot, GameHost buys 60 per game)
run/max_fps=60
# v0.3.8-5 THE PERFORMANCE PACKAGE: no sub-frame timer churn (the games are
# render-driven, delta smoothing's extra scheduler wakeups buy nothing here)
run/delta_smoothing=false

[autoload]

Box="*res://game/core/store.gd"
Jukebox="*res://game/core/audio.gd"
Notify="*res://addons/notify/notify.gd"
LAN="*res://game/core/lan.gd"
LANFIND="*res://game/core/lan_find.gd"
Voice="*res://game/core/lan_voice.gd"

[display]

; v0.1.3 THE RESOLUTION & SCALE RULE (ScaleRule.gd is the source of truth):
; internal resolution stays FIXED at 1080x1920 portrait / 1920x1080
; landscape (9:16 / 16:9 - the owner's FHD+ renders 1:1 native); the
; runtime swaps between the two from REAL window pixels (menu._apply_base,
; the per-frame governor in main._process, host_node). aspect EXPAND is
; the owner's v0.1.3 rule: the design is the MINIMUM canvas and the engine
; grows it to cover the window edge-to-edge - extra canvas in design px on
; taller/wider phones. NO letterbox bars on ANY device, nothing distorted,
; and OS safe insets (notch/gesture bars) are padded as design-px margins.
window/size/viewport_width=1080
window/size/viewport_height=1920
; THE PC WINDOW (v0.4.0-17): desktops open a PORTRAIT 720x1280 window -
; the box menu is portrait content, and the RE-WINDOW LAW (ScaleRule)
; reshapes the window to every content: portrait games stay 9:16, landscape
; games re-window to 16:9 - no empty sides anywhere. F11 / Alt+Enter or the
; settings toggle go fullscreen; the vertical slice (box brown sides) only
; returns in fullscreen or when the user drags the window off-aspect.
window/size/window_width_override=720
window/size/window_height_override=1280
window/handheld/orientation=6
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
; v0.1.3: aspect EXPAND fills the window - the canvas always covers every
; pixel, no letterbox bars exist anymore (clear color only shows for a
; frame during the boot surface swap)
environment/defaults/default_clear_color=Color(0.227451, 0.137255, 0.074510, 1)
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
; v0.4.1 THE SHARPNESS LAW: the PC windows render the 1080x1920 design
; downscaled (a 1600x900 monitor shows it at ~0.75) - without mipmaps the
; linear-filtered raster art aliased into the jagged thumbnails and the
; cloud-ish wash the owner screenshotted (same art is clean on the phone
; because the FHD+ panel samples it 1:1). Canvas items now sample with
; trilinear where the texture ships mips (tools/v041_mipmaps.py generates
; them on the 2D art); vector UI/text are unaffected.
textures/canvas_textures/default_texture_filter=2
