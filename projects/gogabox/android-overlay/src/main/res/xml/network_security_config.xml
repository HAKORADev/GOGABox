<?xml version="1.0" encoding="utf-8"?>
<!-- v043 pass 3 THE LOOPBACK WIRE: the in-app WebView seat (web games)
     talks to the box's own WebSocket bridge on 127.0.0.1:31443 and loads
     the game from the box's own localhost server. Cleartext stays DEAD
     everywhere else - the loopback is the only wire allowed in the clear. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
