# ---- Arsenal toolchain cache (Godot / Android SDK / JDK downloads) ----
# NOTE: pattern WITHOUT the trailing slash on purpose - it must also catch a
# plain FILE named .cache (a stray shell-redirect artifact got committed in
# v040 pass work and CI died on `mkdir .cache: File exists` in bootstrap).
.cache

# ---- Python bytecode (study tools run locally; the .pyc files are noise) ----
__pycache__/
*.pyc

# ---- Build outputs ----
dist/

# ---- Materialized per-build artifacts (generated from locked templates + overlays + shared plugins) ----
# android/build is extracted fresh from the pinned Godot android_source.zip on every build,
# then layered with the project's android-overlay/ and shared plugins/. Never commit it.
projects/*/android/build/
projects/*/android/.build_version
projects/*/addons/

# ---- Godot editor import cache (regenerated by `godot --headless --import`) ----
.godot/

# ---- Gradle ----
.gradle/
projects/*/android/build/.gradle/
projects/*/android/build/build/

# ---- Local secrets / overrides (never commit) ----
.ci/local.env
*.keystore
# Owner-approved exception (v0.0.7): the arsenal RELEASE keystore IS committed
# on purpose - an ephemeral CI keystore made every update "conflict with the
# installed package". Sideload hobby project; rotate before any store upload.
!config/keystore/*.jks

# ---- Session journal (user preference: stays out of the repo) ----
WORKLOG.md

# ---- OS / editor noise ----
.DS_Store
Thumbs.db
*.tmp
*.swp

# ---- never ship binaries from the working tree ----
download/
study_out/
films/
# the local export scratch (the Windows preset's export_path; CI writes the
# same dir and only ever uploads the zipped delivery)
projects/build/

# ---- THE STUDY LAW: study copies never live in the repo ----
# study_locker/ holds the scraped game mirrors (gamesnacks etc.) and belongs
# OUTSIDE the repo (docs/DECOMPILATION.md step 7: "Never commit a study copy";
# docs/AGENTS.md: "study copies live OUTSIDE the repo"). The v040-13 round
# walked 115 scraped files past the law - removed in the break round, the
# data lives in the local locker again. Pattern WITHOUT the trailing slash
# on purpose (the .cache lesson): catches a file OR a dir named study_locker.
study_locker
